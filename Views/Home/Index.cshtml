@model List<Tile>
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Dashboard</h1>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="btn btn-outline-primary btn-sm" asp-controller="Tiles" asp-action="Index"><i class="bi bi-pencil-square"></i> Manage tiles</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="card app-card">
        <div class="card-body text-center text-muted p-5">
            <i class="bi bi-grid display-5"></i>
            <p class="mt-3 mb-0">No tiles have been added yet.</p>
        </div>
    </div>
}
else
{
    <div class="tile-grid">
        @foreach (var tile in Model)
        {
            var icon = tile.Icon ?? (tile.Type == TileType.File ? "bi-file-earmark-arrow-down" : "bi-box-arrow-up-right");
            <a class="dash-tile" asp-action="Open" asp-route-id="@tile.Id"
               target="@(tile.Type == TileType.Url ? "_blank" : "_self")"
               rel="@(tile.Type == TileType.Url ? "noopener noreferrer" : null)">
                <div class="dash-tile-icon"><i class="bi @icon"></i></div>
                <div class="dash-tile-body">
                    <h2 class="dash-tile-title">@tile.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(tile.Description))
                    {
                        <p class="dash-tile-desc">@tile.Description</p>
                    }
                    <div class="dash-tile-meta">
                        @if (tile.Type == TileType.File)
                        {
                            <i class="bi bi-paperclip"></i> @tile.OriginalFileName
                        }
                        else
                        {
                            <i class="bi bi-link-45deg"></i> @(Uri.TryCreate(tile.Url, UriKind.Absolute, out var u) ? u.Host : tile.Url)
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
