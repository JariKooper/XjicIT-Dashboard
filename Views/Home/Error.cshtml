@{
    ViewData["Title"] = "Error";
}
<div class="card app-card mx-auto" style="max-width: 560px;">
    <div class="card-body text-center p-5">
        <i class="bi bi-exclamation-triangle display-4 text-primary"></i>
        <h1 class="h4 mt-3">Something went wrong</h1>
        <p class="text-muted">An error occurred while processing your request.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
    </div>
</div>
