@model TileFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit tile" : "Add tile";
    var isFile = Model.Type == TileType.File;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li><li class="breadcrumb-item"><a asp-action="Index">Tiles</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav>

<div class="card app-card" style="max-width: 720px;">
    <div class="card-body p-4">
        <h1 class="h4 mb-4">@ViewData["Title"]</h1>
        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label class="form-label d-block">Tile type</label>
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="Type" id="typeUrl" value="Url" checked="@(!isFile)" />
                    <label class="btn btn-outline-primary" for="typeUrl"><i class="bi bi-link-45deg"></i> URL</label>
                    <input type="radio" class="btn-check" name="Type" id="typeFile" value="File" checked="@isFile" />
                    <label class="btn btn-outline-primary" for="typeFile"><i class="bi bi-file-earmark"></i> File</label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description <span class="text-muted small">(optional)</span></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">-- Choose a category --</option>
                </select>
                @if (Model.Categories.Count == 0)
                {
                    <div class="form-text">No categories yet. <a asp-controller="Categories" asp-action="Create">Create a category</a> first.</div>
                }
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IconUpload" class="form-label">Icon image <span class="text-muted small">(optional)</span></label>
                <input asp-for="IconUpload" class="form-control" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
                @if (Model.HasIcon)
                {
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <img src="@Url.Action("Icon", "Home", new { id = Model.Id })" alt="" class="dash-tile-img" />
                        <div class="form-check mb-0">
                            <input asp-for="RemoveIcon" class="form-check-input" />
                            <label asp-for="RemoveIcon" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="form-text">Leave empty to keep the current icon.</div>
                }
                <div class="form-text">PNG, JPEG, WebP or GIF. Maximum size: 1 MB.</div>
                <span asp-validation-for="IconUpload" class="text-danger small"></span>
            </div>

            <div class="mb-3 type-section" data-type="Url">
                <label asp-for="Url" class="form-label"></label>
                <input asp-for="Url" class="form-control" type="url" placeholder="https://example.com" />
                <span asp-validation-for="Url" class="text-danger small"></span>
            </div>

            <div class="mb-3 type-section" data-type="File">
                <label asp-for="Upload" class="form-label"></label>
                <input asp-for="Upload" class="form-control" type="file" />
                @if (!string.IsNullOrEmpty(Model.CurrentFileName))
                {
                    <div class="form-text">Current file: <strong>@Model.CurrentFileName</strong>. Leave empty to keep it.</div>
                }
                <div class="form-text">Maximum size: 50 MB.</div>
                <span asp-validation-for="Upload" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const sections = document.querySelectorAll('.type-section');
            function update() {
                const selected = document.querySelector('input[name="Type"]:checked').value;
                sections.forEach(s => s.classList.toggle('d-none', s.dataset.type !== selected));
            }
            document.querySelectorAll('input[name="Type"]').forEach(r => r.addEventListener('change', update));
            update();
        })();
    </script>
}
