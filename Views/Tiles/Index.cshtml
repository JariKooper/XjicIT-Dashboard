@model List<Tile>
@{
    ViewData["Title"] = "Manage tiles";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li><li class="breadcrumb-item active">Tiles</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Tiles</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add tile</a>
</div>

<div class="card app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 110px;">Order</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Target</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No tiles yet.</td></tr>
                }
                @for (var i = 0; i < Model.Count; i++)
                {
                    var tile = Model[i];
                    <tr>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <form asp-action="Move" asp-route-id="@tile.Id" method="post" class="d-inline">
                                    <input type="hidden" name="direction" value="up" />
                                    <button type="submit" class="btn btn-outline-primary" title="Move up" disabled="@(i == 0)"><i class="bi bi-arrow-up"></i></button>
                                </form>
                                <form asp-action="Move" asp-route-id="@tile.Id" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="direction" value="down" />
                                    <button type="submit" class="btn btn-outline-primary" title="Move down" disabled="@(i == Model.Count - 1)"><i class="bi bi-arrow-down"></i></button>
                                </form>
                            </div>
                        </td>
                        <td>
                            <strong>@tile.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(tile.Description)) { <div class="small text-muted">@tile.Description</div> }
                        </td>
                        <td>@tile.Category.Name</td>
                        <td><span class="badge @(tile.Type == TileType.File ? "badge-file" : "badge-url")">@tile.Type</span></td>
                        <td class="text-break small">
                            @if (tile.Type == TileType.File)
                            {
                                <a asp-controller="Home" asp-action="Open" asp-route-id="@tile.Id">@tile.OriginalFileName</a>
                                @if (tile.FileSize.HasValue) { <span class="text-muted">(@((tile.FileSize.Value / 1024.0).ToString("N0")) KB)</span> }
                            }
                            else
                            {
                                <a href="@tile.Url" target="_blank" rel="noopener noreferrer">@tile.Url</a>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tile.Id"><i class="bi bi-pencil"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tile.Id"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
