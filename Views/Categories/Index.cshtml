@model List<Category>
@{
    ViewData["Title"] = "Manage categories";
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li><li class="breadcrumb-item active">Categories</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Categories</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add category</a>
</div>

<div class="card app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 110px;">Order</th>
                    <th>Name</th>
                    <th>Access</th>
                    <th>Tiles</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No categories yet.</td></tr>
                }
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.SortOrder</td>
                        <td><strong>@category.Name</strong></td>
                        <td>
                            @if (category.IsPublic)
                            {
                                <span><i class="bi bi-globe"></i> Public</span>
                            }
                            else
                            {
                                <span><i class="bi bi-lock"></i> Private</span>
                                <div class="small text-muted">@(category.AllowedUsers.Count == 0 ? "Admins only" : string.Join(", ", category.AllowedUsers.Select(cu => cu.User.UserName).OrderBy(n => n)))</div>
                            }
                        </td>
                        <td>@category.Tiles.Count</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id"><i class="bi bi-pencil"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
