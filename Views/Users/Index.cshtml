@model List<AppUser>
@{
    ViewData["Title"] = "Manage users";
    var currentUserId = (int)ViewBag.CurrentUserId;
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li><li class="breadcrumb-item active">Users</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Users</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Create user</a>
</div>

<div class="card app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <i class="bi bi-person text-primary"></i> <strong>@user.UserName</strong>
                            @if (user.Id == currentUserId) { <span class="badge bg-secondary-subtle text-secondary ms-1">you</span> }
                        </td>
                        <td><span class="badge @(user.Role == Roles.Admin ? "badge-file" : "badge-url")">@user.Role</span></td>
                        <td class="small text-muted">@user.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id"><i class="bi bi-pencil"></i> Edit</a>
                            @if (user.Id != currentUserId)
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@user.Id"><i class="bi bi-trash"></i> Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
