{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/dashboard.db"
  },
  "Uploads": {
    "Folder": "App_Data/uploads",
    "MaxFileSizeMB": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
